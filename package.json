{
  "name": "essensplan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:build": "tsx supabase/seed/build-seed-sql.ts",
    "sample-week": "tsx scripts/sample-week.ts",
    "db:check": "tsx --env-file=.env.local scripts/check-supabase.ts",
    "import:eval": "tsx --env-file=.env.local scripts/import-eval.ts",
    "import:eval-verify": "tsx --env-file=.env.local scripts/verify-eval.ts",
    "import:eval-steps": "tsx --env-file=.env.local scripts/steps-eval.ts",
    "import:eval-frame": "tsx --conditions=react-server --env-file=.env.local scripts/frame-eval.ts",
    "import:photo": "tsx --env-file=.env.local scripts/import-photo.ts",
    "import:servings-units": "tsx --env-file=.env.local scripts/servings-units.ts",
    "import:frame-photos": "tsx --conditions=react-server --env-file=.env.local scripts/frame-photos.ts",
    "import:fill-steps": "tsx --conditions=react-server --env-file=.env.local scripts/fill-steps.ts",
    "import:tag-recipes": "tsx --conditions=react-server --env-file=.env.local scripts/tag-recipes.ts",
    "db:types": "supabase gen types typescript --linked --schema public > src/server/supabase/database.types.ts",
    "library:split-sources": "tsx --env-file=.env.local scripts/split-sources.ts",
    "e2e:setup": "tsx --env-file=.env.local scripts/e2e-household.ts",
    "e2e:teardown": "tsx --env-file=.env.local scripts/e2e-household.ts --teardown",
    "e2e:batch": "tsx --conditions=react-server --env-file=.env.local scripts/batch-smoke.ts",
    "supermarkets:search": "tsx --conditions=react-server scripts/supermarket-search.ts",
    "e2e": "playwright test --grep-invert \"@look|@api\"",
    "e2e:offline": "E2E_PROD=1 E2E_PORT=3200 playwright test e2e/offline.spec.ts",
    "e2e:look": "playwright test --grep @look",
    "e2e:upload": "playwright test --grep @api --project desktop",
    "icons:build": "tsx scripts/build-icons.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "heic-decode": "^2.1.0",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
