# dependencies
/node_modules

# next.js
/.next/
next-env.d.ts
*.tsbuildinfo

# env files: never commit secrets. Only the example file is tracked.
.env*
!.env.example

# vercel
.vercel

# supabase CLI state (also in supabase/.gitignore; Prettier reads only this file)
/supabase/.branches
/supabase/.temp

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# misc
.DS_Store
*.pem
npm-debug.log*

# Family sample photos (private, never commit)
samples/

# Backups of the hosted database and photos (docs/DEPLOYMENT.md): the family's data
/backup/
*.dump

# Agent skills installed locally (skills CLI); skills-lock.json says where they come from
/.claude/
/skills-lock.json
